# Maintainer: yoshitsugu
# shellcheck shell=bash disable=SC2034,SC2154
pkgbase=tgskk-git
pkgname=('tgskk-common-git' 'tgskk-git' 'tgskk-ibus-git')
pkgver=0.1.0
pkgrel=2
pkgdesc='SKK input method with local AI ranking and Google fallback'
arch=('x86_64')
url='https://github.com/yoshitsugu/tgskk'
license=('GPL-3.0-or-later')
makedepends=('git' 'rust>=1.88' 'cargo>=1.88' 'cmake' 'ninja' 'pkgconf' 'fcitx5>=5.1.7' 'ibus>=1.5.26' 'dbus' 'python>=3.12' 'skk-jisyo')
# Mixed Rust/C archives cannot use makepkg's GCC LTO; Cargo manages Rust LTO.
options=('!debug' '!lto')
source=('tgskk::git+https://github.com/yoshitsugu/tgskk.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/tgskk" || return
  if [[ -d .git ]]; then
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  else
    printf '%s' "$pkgver"
  fi
}
prepare() {
  cd "$srcdir/tgskk" || return
  bash scripts/build-dist.sh prepare
}
build() {
  cd "$srcdir/tgskk" || return
  bash scripts/build-dist.sh build
}
check() {
  cd "$srcdir/tgskk" || return
  bash scripts/build-dist.sh check
}
package_tgskk-common-git() {
  pkgdesc='Shared model tools and workers for tgskk'
  depends=('gcc-libs' 'glibc' 'python>=3.12' 'skk-jisyo')
  provides=("tgskk-common=$pkgver")
  conflicts=('tgskk-common')
  cd "$srcdir/tgskk" || return
  bash scripts/build-dist.sh install "$pkgdir" common
}
package_tgskk-git() {
  pkgdesc='SKK input method for fcitx5 with local context ranking'
  depends=('fcitx5>=5.1.7' 'libxkbcommon' "tgskk-common-git=$pkgver-$pkgrel")
  provides=('tgskk')
  conflicts=('tgskk')
  cd "$srcdir/tgskk" || return
  bash scripts/build-dist.sh install "$pkgdir" fcitx5
}
package_tgskk-ibus-git() {
  pkgdesc='SKK input method for IBus with local context ranking'
  depends=('ibus>=1.5.26' 'libxkbcommon' "tgskk-common-git=$pkgver-$pkgrel")
  provides=('tgskk-ibus')
  conflicts=('tgskk-ibus')
  cd "$srcdir/tgskk" || return
  bash scripts/build-dist.sh install "$pkgdir" ibus
}
